# AI STUDY TWIN - Environment Configuration

# Database (PostgreSQL)
POSTGRES_DB=AiStudyTwinDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5432
DATABASE_URL=Host=localhost;Port=5432;Database=AiStudyTwinDb;Username=postgres;Password=postgrespassword

# ASP.NET Core Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# Security (JWT)
Jwt__Key=AI_STUDY_TWIN_ULTRA_SECURE_JWT_SECRET_KEY_2026_SUPER_SAFE_LONG_KEY_FOR_HMAC_SHA256!
Jwt__Issuer=AiStudyTwin
Jwt__Audience=AiStudyTwinApp

# AI Providers (Multi-tier fallback supported: Gemini -> Groq -> OpenAI -> OpenRouter -> DeepSeek)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
AI_PROVIDER=Auto

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000/api

